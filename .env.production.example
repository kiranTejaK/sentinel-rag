# ==============================================================================
# SentinelRAG Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on your target deployment server:
#   cp .env.production.example .env.production
#
# SECRET GENERATION GUIDELINES:
# To generate cryptographically secure 32+ byte strings for APP_SECRET and passwords:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -base64 32
# ==============================================================================

# Application & Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Secure Application Secret (generate using `openssl rand -hex 32`)
APP_SECRET=replace_with_64_char_hex_secret_generated_via_openssl_or_secrets

# PostgreSQL 16 + pgvector Production Database Configuration
# In docker-compose production setup, db host resolves to container service 'db'
DATABASE_URL=postgresql+asyncpg://sentinel_prod:generate_strong_db_password_here@db:5432/sentinel_prod_db
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=15
DB_TIMEOUT_SECONDS=30

# PostgreSQL Container Credentials (used by sentinel_db service container)
POSTGRES_USER=sentinel_prod
POSTGRES_PASSWORD=generate_strong_db_password_here
POSTGRES_DB=sentinel_prod_db

# Redis 7.2 Cache & Rate Limiting Configuration
# In docker-compose production setup, cache host resolves to container service 'cache'
REDIS_URL=redis://:generate_strong_redis_password_here@cache:6379/0
REDIS_PASSWORD=generate_strong_redis_password_here
REDIS_POOL_SIZE=100
REDIS_TIMEOUT_MS=500

# Semantic Cache Configuration
SEMANTIC_CACHE_THRESHOLD=0.08
SEMANTIC_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Distributed Token-Bucket Rate Limiting (per API key / tenant)
RATE_LIMIT_DEFAULT_CAPACITY=120
RATE_LIMIT_DEFAULT_REFILL_RATE_PER_SEC=15

# Resilient Multi-Provider LLM Router (LiteLLM)
DEFAULT_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
DEFAULT_FALLBACK_MODEL_1=openai/gpt-4o-mini
DEFAULT_FALLBACK_MODEL_2=mistral/mistral-small-latest

# Upstream Provider Production API Keys (Keep Strictly Secret)
OPENAI_API_KEY=sk-proj-prod-your-openai-api-key-here
GROQ_API_KEY=gsk_prod-your-groq-api-key-here
ANTHROPIC_API_KEY=sk-ant-prod-your-anthropic-api-key-here
MISTRAL_API_KEY=prod-your-mistral-api-key-here

# State-Machine Circuit Breaker Thresholds
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=60
CIRCUIT_BREAKER_TIMEOUT_SECONDS=4.0
