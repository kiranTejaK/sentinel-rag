# ==============================================================================
# SentinelRAG Environment Configuration
# ==============================================================================

# Application & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_SECRET=dev-insecure-secret-key-change-in-production-32bytes

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinel_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=30

# Redis 7 Configuration (Semantic Cache & Distributed Rate Limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50
REDIS_TIMEOUT_MS=500

# Semantic Cache Configuration
SEMANTIC_CACHE_THRESHOLD=0.08
SEMANTIC_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Rate Limiting (Token-Bucket defaults)
RATE_LIMIT_DEFAULT_CAPACITY=100
RATE_LIMIT_DEFAULT_REFILL_RATE_PER_SEC=10

# Resilient LLM Routing (LiteLLM)
DEFAULT_PRIMARY_MODEL=openai/gpt-4o-mini
DEFAULT_FALLBACK_MODEL_1=anthropic/claude-3-5-sonnet-20241022
DEFAULT_FALLBACK_MODEL_2=groq/llama-3.3-70b-versatile

# Provider API Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GROQ_API_KEY=gsk_your-groq-api-key-here

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=30
CIRCUIT_BREAKER_TIMEOUT_SECONDS=4.0
